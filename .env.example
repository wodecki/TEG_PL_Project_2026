# Skopiuj do .env i wpisz klucz OpenAI (polecane; zobacz „Który LLM?” w README.md).
# Inny dostawca: wpisz poniżej jego klucz (Ollama nie potrzebuje żadnego). Kroki 1–5 Miniprojektu 1 w ogóle nie wymagają klucza.

# provider: openai – używa go też try_search.py do obliczania wektorowych reprezentacji twoich pytań
OPENAI_API_KEY=

# provider: openrouter
OPENROUTER_API_KEY=
